expression fnGetPgTable = ```
		(schemaName as text, tableName as text) as table => 
		let
		    
		    Source = PostgreSQL.Database(DbServer, DbName),
		    
		    Result = Source{[Schema = schemaName, Item = tableName]}[Data]
		in
		    Result
		```
