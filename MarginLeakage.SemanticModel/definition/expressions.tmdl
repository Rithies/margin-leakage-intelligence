expression stg_Machines =
		let
		    // Machine master from the costing department's workbook. The sheet has title rows above the header.
		    Source = Excel.Workbook(File.Contents(DataFolder & "masters\machines_and_rate_card.xlsx"), false),
		    Sheet = Source{[Item = "Machines", Kind = "Sheet"]}[Data],
		    Promoted = fnPromoteHeaderRow(Sheet, "Machine Code"),
		    Renamed = Table.RenameColumns(
		        Promoted,
		        {
		            {"Machine Code", "machine_code"}, {"Machine Name", "machine_name"}, {"Work Centre", "work_centre"},
		            {"Rated Speed / hr", "rated_speed_per_hr"}, {"Estimating Speed / hr", "estimating_speed_per_hr"},
		            {"Std Makeready Hrs", "std_makeready_hrs"}, {"Max Colours", "max_colours"}, {"Sheet Format", "sheet_format"},
		            {"Speed Unit", "speed_unit"}, {"Shifts Worked", "shifts_worked"}
		        }
		    ),
		    Typed = Table.TransformColumnTypes(
		        Renamed,
		        {
		            {"machine_code", type text}, {"machine_name", type text}, {"work_centre", type text},
		            {"rated_speed_per_hr", Int64.Type}, {"estimating_speed_per_hr", Int64.Type}, {"std_makeready_hrs", type number},
		            {"max_colours", Int64.Type}, {"sheet_format", type text}, {"speed_unit", type text}, {"shifts_worked", type text}
		        },
		        "en-IN"
		    )
		in
		    Typed
	lineageTag: a313294a-40d0-47a2-bcec-aa77c517811e
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_MachineRates =
		let
		    // Machine hour rates approved by Finance, effective-dated (one row per machine per rate change).
		    Source = Excel.Workbook(File.Contents(DataFolder & "masters\machines_and_rate_card.xlsx"), false),
		    Sheet = Source{[Item = "Rate History", Kind = "Sheet"]}[Data],
		    Promoted = fnPromoteHeaderRow(Sheet, "Machine Code"),
		    Renamed = Table.RenameColumns(
		        Promoted,
		        {
		            {"Machine Code", "machine_code"}, {"Effective From", "effective_from"},
		            {"Hourly Rate (INR, incl. labour & overhead)", "hourly_rate_inr"}
		        }
		    ),
		    Typed = Table.TransformColumnTypes(
		        Renamed,
		        {{"machine_code", type text}, {"effective_from", type date}, {"hourly_rate_inr", type number}},
		        "en-IN"
		    )
		in
		    Typed
	lineageTag: c9d12afd-f0c6-4aa5-9707-ba7ce12486fc
