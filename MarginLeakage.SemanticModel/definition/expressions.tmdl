	annotation PBI_ResultType = Table

expression stg_ReworkLog =
		let
		    // QA rework log: one sheet per calendar year, same columns on each. New year sheets are picked up automatically.
		    Source = Excel.Workbook(File.Contents(DataFolder & "quality\rework_log.xlsx"), true),
		    YearSheets = Table.SelectRows(Source, each [Kind] = "Sheet" and Text.StartsWith([Name], "Rework ")),
		    Combined = Table.Combine(YearSheets[Data]),
		    NonBlank = Table.SelectRows(Combined, each [rework_id] <> null and [rework_id] <> ""),
		    Typed = Table.TransformColumnTypes(
		        NonBlank,
		        {
		            {"rework_id", type text}, {"job_no", type text}, {"reported_on", type date}, {"reason_code", type text},
		            {"machine_code", type text}, {"rework_hours", type number}, {"extra_sheets", Int64.Type},
		            {"extra_board_kg", type number}, {"labour_hours", type number}, {"remarks", type text}
		        },
		        "en-IN"
		    ),
		    Standardised = Table.TransformColumns(
		        Typed,
		        {
		            {"job_no", fnNormaliseJobNo, type nullable text},
		            {"machine_code", each Text.Remove(Text.Upper(Text.Trim(_)), {"-", " "}), type text}
		        }
		    )
		in
		    Standardised
	lineageTag: cb79a130-8398-460d-9bd4-4cd1c72a072c
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_ReworkLogCosted =
		let
		    // Rework costed per policy rule 10: rework hours at the machine rate on the reported date, labour hours at the
		    // labour rate, and extra board kg at the board price of the job's SKU grade in the reported month.
		    JobSku = Table.Buffer(Table.SelectColumns(stg_Jobs, {"job_no", "sku_code"})),
		    SkuGrade = Table.Buffer(Table.SelectColumns(stg_Skus, {"sku_code", "board_grade"})),
		    WithSku = Table.ExpandTableColumn(
		        Table.NestedJoin(stg_ReworkLog, {"job_no"}, JobSku, {"job_no"}, "Job", JoinKind.LeftOuter), "Job", {"sku_code"}
		    ),
		    WithGrade = Table.ExpandTableColumn(
		        Table.NestedJoin(WithSku, {"sku_code"}, SkuGrade, {"sku_code"}, "Sku", JoinKind.LeftOuter), "Sku", {"board_grade"}
		    ),
		    Typed = Table.TransformColumnTypes(WithGrade, {{"sku_code", type text}, {"board_grade", type text}}),
		    WithMachineRate = fnAddEffectiveValue(Typed, "machine_code", "reported_on", stg_MachineRates, "machine_code", "effective_from", "hourly_rate_inr", "machine_rate_inr"),
		    // Board prices are monthly (month_start), so the latest month_start on or before the date is that month's price.
		    WithBoardPrice = fnAddEffectiveValue(WithMachineRate, "board_grade", "reported_on", stg_BoardPriceHistory, "grade_code", "month_start", "price_inr_per_kg", "board_price_inr_per_kg"),
		    MachineCost = Table.AddColumn(WithBoardPrice, "rework_machine_cost_inr", each [rework_hours] * [machine_rate_inr], type nullable number),
		    LabourCost = Table.AddColumn(MachineCost, "rework_labour_cost_inr", each [labour_hours] * LabourRateInrPerHour, type nullable number),
		    BoardCost = Table.AddColumn(LabourCost, "rework_board_cost_inr", each [extra_board_kg] * [board_price_inr_per_kg], type nullable number),
		    TotalCost = Table.AddColumn(
		        BoardCost,
		        "rework_cost_inr",
		        each [rework_machine_cost_inr] + [rework_labour_cost_inr] + [rework_board_cost_inr],
		        type nullable number
		    )
		in
		    TotalCost
	lineageTag: 43cb5975-bb44-475a-9333-80e5c511771b
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_Budget =
		let
		    // Annual operating plan: one sheet per financial year, with title rows above a wide month-by-month table.
		    // Output grain: segment x month. Revenue in INR, gross margin as a fraction and in INR.
		    Source = Excel.Workbook(File.Contents(DataFolder & "finance\budget.xlsx"), false),
		    FySheets = Table.SelectRows(Source, each [Kind] = "Sheet" and Text.StartsWith([Name], "FY")),
		    // Each sheet has its own month headers, so promote and unpivot per sheet before combining.
		    Unpivoted = List.Transform(
		        FySheets[Data],
		        each Table.UnpivotOtherColumns(fnPromoteHeaderRow(_, "Measure"), {"Measure", "Segment"}, "month_label", "value")
		    ),
		    Combined = Table.Combine(Unpivoted),
		    Typed = Table.TransformColumnTypes(
		        Combined,
		        {{"Measure", type text}, {"Segment", type text}, {"month_label", type text}, {"value", type number}},
		        "en-IN"
		    ),
		    WithMonth = Table.AddColumn(Typed, "month_start", each Date.FromText([month_label], [Format = "MMM-yy", Culture = "en-US"]), type date),
		    MeasureCodes = Table.TransformColumns(
		        WithMonth,
		        {{"Measure", each if Text.StartsWith(_, "Revenue") then "revenue_lakh" else if Text.StartsWith(_, "Gross margin") then "gross_margin_pct" else _, type text}}
		    ),
		    Slim = Table.SelectColumns(MeasureCodes, {"Segment", "month_start", "Measure", "value"}),
		    Pivoted = Table.Pivot(Slim, {"revenue_lakh", "gross_margin_pct"}, "Measure", "value"),
		    // Unit conversion: 1 lakh = 100,000 rupees; margin is stored as a percentage number (23 = 23%).
		    Revenue = Table.AddColumn(Pivoted, "budget_revenue_inr", each [revenue_lakh] * 100000, type number),
		    Margin = Table.AddColumn(Revenue, "budget_gross_margin_pct", each [gross_margin_pct] / 100, type number),
		    MarginInr = Table.AddColumn(Margin, "budget_gross_margin_inr", each [budget_revenue_inr] * [budget_gross_margin_pct], type number),
		    Result = Table.RenameColumns(
		        Table.SelectColumns(MarginInr, {"Segment", "month_start", "budget_revenue_inr", "budget_gross_margin_pct", "budget_gross_margin_inr"}),
		        {{"Segment", "segment"}}
		    )
		in
		    Result
	lineageTag: 8a6adac2-2758-4795-81de-10b45b94b32b
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_FxDaily =
		let
		    // Daily FX table covering every calendar day from the first to the last published rate.
		    // Days with no published rate (weekends, holidays) take the last rate before them (policy rule 4).
		    // INR rows at 1.0 make every document's conversion one lookup on (currency, date).
		    // The source publishes USD only; a second foreign currency would need its own fill-forward.
		    Published = Table.Buffer(Table.SelectColumns(stg_FxRatesUsdInr, {"rate_date", "inr_per_unit"})),
		    FirstDate = List.Min(Published[rate_date]),
		    LastDate = List.Max(Published[rate_date]),
		    Days = List.Dates(FirstDate, Duration.Days(LastDate - FirstDate) + 1, #duration(1, 0, 0, 0)),
		    Calendar = Table.TransformColumnTypes(Table.FromList(Days, Splitter.SplitByNothing(), {"rate_date"}), {{"rate_date", type date}}),
		    Joined = Table.NestedJoin(Calendar, {"rate_date"}, Published, {"rate_date"}, "Fx", JoinKind.LeftOuter),
		    Expanded = Table.TransformColumnTypes(Table.ExpandTableColumn(Joined, "Fx", {"inr_per_unit"}), {{"inr_per_unit", type number}}),
		    Flagged = Table.AddColumn(Expanded, "is_filled", each [inr_per_unit] = null, type logical),
		    // Fill down only works on sorted rows: a join does not guarantee order.
		    Sorted = Table.Sort(Flagged, {{"rate_date", Order.Ascending}}),
		    Filled = Table.FillDown(Sorted, {"inr_per_unit"}),
		    Usd = Table.AddColumn(Filled, "currency", each "USD", type text),
		    Inr = Table.AddColumn(
		        Table.AddColumn(Table.AddColumn(Calendar, "inr_per_unit", each 1, type number), "is_filled", each false, type logical),
		        "currency", each "INR", type text
		    ),
		    Result = Table.SelectColumns(Table.Combine({Usd, Inr}), {"currency", "rate_date", "inr_per_unit", "is_filled"})
		in
		    Result
	lineageTag: ef1dc99e-fcd6-4dee-8e97-70523926cd76
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_JobQuoteLink =
		let
		    // One row per job with the quote it belongs to. Repeat jobs keyed without a quote get the latest Won quote
		    // for the same SKU dated on or before the order date; ties go to the higher quote_id (costing policy).
		    // quote_link records how each link was made, so inferred links stay visible in the report.
		    Jobs = Table.SelectColumns(stg_Jobs, {"job_no", "sku_code", "order_date", "quote_id"}),
		    WonQuotes = Table.Buffer(
		        Table.Sort(
		            Table.SelectColumns(Table.SelectRows(stg_Quotes, each [status] = "Won"), {"quote_id", "sku_code", "quote_date"}),
		            {{"quote_date", Order.Descending}, {"quote_id", Order.Descending}}
		        )
		    ),
		    FindQuote = (sku as text, onDate as date) as nullable text =>
		        let
		            Candidates = Table.SelectRows(WonQuotes, each [sku_code] = sku and [quote_date] <= onDate)
		        in
		            if Table.IsEmpty(Candidates) then null else Candidates{0}[quote_id],
		    Resolved = Table.AddColumn(
		        Jobs,
		        "resolved_quote_id",
		        each if [quote_id] <> null then [quote_id] else FindQuote([sku_code], [order_date]),
		        type nullable text
		    ),
		    Flagged = Table.AddColumn(
		        Resolved,
		        "quote_link",
		        each if [quote_id] <> null then "Keyed" else if [resolved_quote_id] <> null then "Inferred" else "Unresolved",
		        type text
		    ),
		    Selected = Table.SelectColumns(Flagged, {"job_no", "quote_id", "resolved_quote_id", "quote_link"}),
		    // Two renames, not one: renaming into a name that another column still holds would clash.
		    KeyedRenamed = Table.RenameColumns(Selected, {{"quote_id", "keyed_quote_id"}}),
		    Result = Table.RenameColumns(KeyedRenamed, {{"resolved_quote_id", "quote_id"}})
		in
		    Result
	lineageTag: c8b71860-5e91-42c9-9fea-4007155fe11e
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_QuoteEstimateLines =
		let
		    // Quote estimates unpivoted from one column per cost element to one row per quote x cost element,
		    // so estimates line up with actuals by element_code. Driver columns (sheets, kg, hours) are not costs and stay out.
		    EstimateColumns = List.Buffer(stg_CostElements[estimate_column]),
		    Wide = Table.SelectColumns(stg_QuoteEstimates, {"quote_id"} & EstimateColumns),
		    Long = Table.Unpivot(Wide, EstimateColumns, "estimate_column", "est_cost_inr"),
		    Joined = Table.NestedJoin(Long, {"estimate_column"}, stg_CostElements, {"estimate_column"}, "Element", JoinKind.Inner),
		    Expanded = Table.ExpandTableColumn(Joined, "Element", {"element_code"}),
		    Result = Table.TransformColumnTypes(
		        Table.SelectColumns(Expanded, {"quote_id", "element_code", "est_cost_inr"}),
		        {{"element_code", type text}, {"est_cost_inr", type number}}
		    )
		in
		    Result
	lineageTag: 3d0f7aae-3cf3-4e21-8b48-66a354262548
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression val_MachineLog =
		let
		    // Machine log checks. Every failures value must be 0.
		    AllRows = Table.RemoveColumns(stg_MachineLogFiles, {"source_file"}),
		    Log = stg_MachineLog,
		    Activities = {"Make-ready", "Run", "Stoppage", "Wash-up"},
		    Checks = {
		        {"Machine log", "log_id repeated with different content", Table.RowCount(Table.Distinct(AllRows)) - Table.RowCount(Table.Distinct(AllRows, {"log_id"}))},
		        {"Machine log", "log_id still duplicated after de-duplication", Table.RowCount(Log) - List.Count(List.Distinct(Log[log_id]))},
		        {"Machine log", "job_no not found in ERP jobs", fnCountOrphans(Log, "job_no", stg_Jobs, "job_no")},
		        {"Machine log", "machine_code not in machine master", fnCountOrphans(Log, "machine_code", stg_Machines, "machine_code")},
		        {"Machine log", "activity outside the standard list", Table.RowCount(Table.SelectRows(Log, each not List.Contains(Activities, [activity])))},
		        {"Machine log", "duration missing or negative", Table.RowCount(Table.SelectRows(Log, each [duration_hrs] = null or [duration_hrs] < 0))},
		        {"Machine log", "no machine rate on the log date", Table.RowCount(Table.SelectRows(Log, each [hourly_rate_inr] = null))}
		    },
		    Result = #table(type table [area = text, check = text, failures = Int64.Type], Checks)
		in
		    Result
	lineageTag: c257d15c-1be4-440f-979f-badc1809bb12
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

expression val_BoardIssues =
		let
		    // Board issue checks. Every failures value must be 0.
		    Board = stg_BoardIssues,
		    Checks = {
		        {"Board issues", "job_ref blank", Table.RowCount(Table.SelectRows(Board, each [job_no] = null))},
		        {"Board issues", "job_ref not found in ERP jobs", fnCountOrphans(Board, "job_no", stg_Jobs, "job_no")},
		        {"Board issues", "quantity sign does not match txn_type", Table.RowCount(Table.SelectRows(Board, each ([txn_type] = "ISSUE" and [qty] < 0) or ([txn_type] = "RETURN" and [qty] > 0) or not List.Contains({"ISSUE", "RETURN"}, [txn_type])))},
		        {"Board issues", "kg not calculable (unknown uom or sheet size)", Table.RowCount(Table.SelectRows(Board, each [board_kg] = null))},
		        {"Board issues", "board_grade not in board grades master", fnCountOrphans(Board, "board_grade", stg_BoardGrades, "grade_code")}
		    },
		    Result = #table(type table [area = text, check = text, failures = Int64.Type], Checks)
		in
		    Result
	lineageTag: 72e54396-ab53-4e38-8718-4086978cb444
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

expression val_InkIssues =
		let
		    // Ink issue checks. Every failures value must be 0.
		    Map = stg_InkDescriptionMap,
		    Ink = stg_InkIssuesCosted,
		    Checks = {
		        {"Ink issues", "description spelling listed twice in the mapping file", Table.RowCount(Map) - List.Count(List.Distinct(Map[ink_description_key]))},
		        {"Ink issues", "description not in the mapping file", Table.RowCount(Table.SelectRows(Ink, each [ink_code] = null))},
		        {"Ink issues", "row count changed by the mapping join", Table.RowCount(stg_InkIssues) - Table.RowCount(Ink)},
		        {"Ink issues", "job_no not found in ERP jobs", fnCountOrphans(Ink, "job_no", stg_Jobs, "job_no")},
		        {"Ink issues", "no ink price on the issue date", Table.RowCount(Table.SelectRows(Ink, each [price_inr_per_kg] = null))}
		    },
		    Result = #table(type table [area = text, check = text, failures = Int64.Type], Checks)
		in
		    Result
	lineageTag: 4fc2981c-4b91-4f5b-9377-a33786acfce6
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

expression val_PlatesAndDies =
		let
		    // Plate log and die register checks. Every failures value must be 0.
		    Plates = stg_PlateLogCosted,
		    Dies = stg_DieRegister,
		    Checks = {
		        {"Plates and dies", "plate log job_no not found in ERP jobs", fnCountOrphans(Plates, "job_no", stg_Jobs, "job_no")},
		        {"Plates and dies", "plate batch with no price on the made date", Table.RowCount(Table.SelectRows(Plates, each [price_inr_per_plate] = null))},
		        {"Plates and dies", "die_id duplicated", Table.RowCount(Dies) - List.Count(List.Distinct(Dies[die_id]))},
		        {"Plates and dies", "die first_job_no not found in ERP jobs", fnCountOrphans(Dies, "first_job_no", stg_Jobs, "job_no")},
		        {"Plates and dies", "die sku_code not in SKU master", fnCountOrphans(Dies, "sku_code", stg_Skus, "sku_code")}
		    },
		    Result = #table(type table [area = text, check = text, failures = Int64.Type], Checks)
		in
		    Result
	lineageTag: ae5f0b59-aead-4ddf-9a25-f45d08cfb892
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

expression val_ReworkLog =
		let
		    // Rework log checks. Every failures value must be 0.
		    Rework = stg_ReworkLogCosted,
		    Checks = {
		        {"Rework log", "rework_id duplicated", Table.RowCount(Rework) - List.Count(List.Distinct(Rework[rework_id]))},
		        {"Rework log", "job_no not found in ERP jobs", fnCountOrphans(Rework, "job_no", stg_Jobs, "job_no")},
		        {"Rework log", "machine_code not in machine master", fnCountOrphans(Rework, "machine_code", stg_Machines, "machine_code")},
		        {"Rework log", "reason_code not in rework reasons", fnCountOrphans(Rework, "reason_code", stg_ReworkReasons, "reason_code")},
		        {"Rework log", "no machine rate on the reported date", Table.RowCount(Table.SelectRows(Rework, each [machine_rate_inr] = null))},
		        {"Rework log", "extra board kg with no board price", Table.RowCount(Table.SelectRows(Rework, each [extra_board_kg] <> 0 and [board_price_inr_per_kg] = null))}
		    },
		    Result = #table(type table [area = text, check = text, failures = Int64.Type], Checks)
		in
		    Result
	lineageTag: 1cd25943-880b-4f87-9d0e-7b6a759b95e6
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

expression val_Budget =
		let
		    // Budget checks. Every failures value must be 0.
		    Budget = stg_Budget,
		    SegmentMonths = Table.RowCount(Table.Distinct(Table.SelectColumns(Budget, {"segment", "month_start"}))),
		    ExpectedSegmentMonths = List.Count(List.Distinct(Budget[month_start])) * Table.RowCount(stg_SegmentList),
		    Checks = {
		        {"Budget", "segment not in the reference list", fnCountOrphans(Budget, "segment", stg_SegmentList, "segment")},
		        {"Budget", "segment x month appears more than once", Table.RowCount(Budget) - SegmentMonths},
		        {"Budget", "segment x month missing", ExpectedSegmentMonths - SegmentMonths},
		        {"Budget", "revenue or margin missing", Table.RowCount(Table.SelectRows(Budget, each [budget_revenue_inr] = null or [budget_gross_margin_pct] = null))}
		    },
		    Result = #table(type table [area = text, check = text, failures = Int64.Type], Checks)
		in
		    Result
	lineageTag: f3c8c7a5-13ce-45a3-9697-bb76f8317622
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

expression val_JobQuoteLink =
		let
		    // Job-to-quote link checks. Every failures value must be 0.
		    Link = stg_JobQuoteLink,
		    WonQuotes = Table.SelectRows(stg_Quotes, each [status] = "Won"),
		    Checks = {
		        {"Job quote link", "row count differs from ERP jobs", Table.RowCount(stg_Jobs) - Table.RowCount(Link)},
		        {"Job quote link", "job with no quote after inference", Table.RowCount(Table.SelectRows(Link, each [quote_link] = "Unresolved"))},
		        {"Job quote link", "linked quote not found among Won quotes", fnCountOrphans(Link, "quote_id", WonQuotes, "quote_id")}
		    },
		    Result = #table(type table [area = text, check = text, failures = Int64.Type], Checks)
		in
		    Result
	lineageTag: da08aaad-3e28-4737-be3e-cfa1f6b6a2db
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

expression val_QuoteEstimateLines =
		let
		    // Quote estimate unpivot checks. Tolerance Rs 5 because each of the 8 elements is rounded to whole rupees (D-11). Every failures value must be 0.
		    Lines = stg_QuoteEstimateLines,
		    ElementCount = Table.RowCount(stg_CostElements),
		    PerQuote = Table.Group(Lines, {"quote_id"}, {{"lines_total", each List.Sum([est_cost_inr]), type number}, {"line_count", each Table.RowCount(_), Int64.Type}}),
		    Compared = Table.ExpandTableColumn(Table.NestedJoin(PerQuote, {"quote_id"}, Table.SelectColumns(stg_QuoteEstimates, {"quote_id", "est_total_cost"}), {"quote_id"}, "Q", JoinKind.LeftOuter), "Q", {"est_total_cost"}),
		    Checks = {
		        {"Quote estimate lines", "quote lines do not add up to est_total_cost", Table.RowCount(Table.SelectRows(Compared, each [est_total_cost] = null or Number.Abs([lines_total] - [est_total_cost]) > 5))},
		        {"Quote estimate lines", "quote without the full set of cost elements", Table.RowCount(Table.SelectRows(PerQuote, each [line_count] <> ElementCount))},
		        {"Quote estimate lines", "quotes lost in the unpivot", Table.RowCount(stg_QuoteEstimates) - Table.RowCount(PerQuote)}
		    },
		    Result = #table(type table [area = text, check = text, failures = Int64.Type], Checks)
		in
		    Result
	lineageTag: e2dc2b11-82e7-4267-a23f-b10d9f6a9457
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

expression val_FxDaily =
		let
		    // FX table checks. Every failures value must be 0.
		    Fx = stg_FxDaily,
		    Days = Duration.Days(List.Max(Fx[rate_date]) - List.Min(Fx[rate_date])) + 1,
		    Documents = Table.Distinct(Table.Combine({
		        Table.RenameColumns(Table.SelectColumns(stg_SalesInvoices, {"currency", "invoice_date"}), {{"invoice_date", "rate_date"}}),
		        Table.RenameColumns(Table.SelectColumns(stg_CreditNotes, {"currency", "cn_date"}), {{"cn_date", "rate_date"}}),
		        Table.RenameColumns(Table.SelectColumns(stg_Quotes, {"currency", "quote_date"}), {{"quote_date", "rate_date"}})
		    })),
		    Uncovered = Table.NestedJoin(Documents, {"currency", "rate_date"}, Fx, {"currency", "rate_date"}, "Fx", JoinKind.LeftAnti),
		    Checks = {
		        {"FX daily", "calendar day missing for a currency", Days * List.Count(List.Distinct(Fx[currency])) - Table.RowCount(Fx)},
		        {"FX daily", "rate still missing after fill-forward", Table.RowCount(Table.SelectRows(Fx, each [inr_per_unit] = null))},
		        {"FX daily", "document currency and date with no rate", Table.RowCount(Uncovered)}
		    },
		    Result = #table(type table [area = text, check = text, failures = Int64.Type], Checks)
		in
		    Result
	lineageTag: 9a306243-6e9e-4d41-87c4-1e0e72fcfcb9
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

/// Overhead charged on each job's direct actual cost (costing policy rule 12).
expression OverheadRate = 0.045 meta [IsParameterQuery=true, Type="Number", IsParameterQueryRequired=true]
	queryGroup: '00 Parameters'

	annotation PBI_ResultType = Number

expression stg_JobsMapped =
		let
		    // ERP jobs with legacy customer codes replaced by the master code (D-13). The original code is kept as customer_code_source.
		    Result = fnMapCustomerCode(stg_Jobs, "customer_code")
		in
		    Result
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_QuotesInr =
		let
		    // Quotes with master customer codes and the quoted value in INR at the quote-date rate (policy rules 2 and 4).
		    Mapped = fnMapCustomerCode(stg_Quotes, "customer_code"),
		    Fx = Table.SelectColumns(stg_FxDaily, {"currency", "rate_date", "inr_per_unit"}),
		    Joined = Table.NestedJoin(Mapped, {"currency", "quote_date"}, Fx, {"currency", "rate_date"}, "Fx", JoinKind.LeftOuter),
		    Expanded = Table.ExpandTableColumn(Joined, "Fx", {"inr_per_unit"}, {"fx_rate"}),
		    Typed = Table.TransformColumnTypes(Expanded, {{"fx_rate", type number}}),
		    WithInr = Table.AddColumn(Typed, "quoted_value_inr", each [quoted_value] * [fx_rate], type number),
		    // Revision 1 is a re-price of a repeat order and is always Won, so it would inflate the win rate.
		    WithRequote = Table.AddColumn(WithInr, "is_requote", each [revision] > 0, type logical)
		in
		    WithRequote
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_InvoicesInr =
		let
		    // Sales invoices with master customer codes, in INR at the invoice-date rate (policy rules 3 and 4).
		    // Revenue = qty x rate per 1000 / 1000. GST is collected for the government and is not revenue.
		    Mapped = fnMapCustomerCode(stg_SalesInvoices, "customer_code"),
		    Fx = Table.SelectColumns(stg_FxDaily, {"currency", "rate_date", "inr_per_unit"}),
		    Joined = Table.NestedJoin(Mapped, {"currency", "invoice_date"}, Fx, {"currency", "rate_date"}, "Fx", JoinKind.LeftOuter),
		    Expanded = Table.ExpandTableColumn(Joined, "Fx", {"inr_per_unit"}, {"fx_rate"}),
		    Typed = Table.TransformColumnTypes(Expanded, {{"fx_rate", type number}}),
		    WithRevenue = Table.AddColumn(Typed, "revenue_inr", each [qty] * [rate_per_1000] / 1000 * [fx_rate], type number),
		    WithTotal = Table.AddColumn(WithRevenue, "invoice_total_inr", each [invoice_total] * [fx_rate], type number)
		in
		    WithTotal
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_CreditNotesInr =
		let
		    // Credit notes in INR at the credit-note-date rate. A credit note belongs to the job of its invoice (policy rule 3),
		    // so the job comes from the invoice, not from the credit note's own customer code.
		    Fx = Table.SelectColumns(stg_FxDaily, {"currency", "rate_date", "inr_per_unit"}),
		    Joined = Table.NestedJoin(stg_CreditNotes, {"currency", "cn_date"}, Fx, {"currency", "rate_date"}, "Fx", JoinKind.LeftOuter),
		    Expanded = Table.ExpandTableColumn(Joined, "Fx", {"inr_per_unit"}, {"fx_rate"}),
		    WithInr = Table.AddColumn(Table.TransformColumnTypes(Expanded, {{"fx_rate", type number}}), "cn_inr", each [amount] * [fx_rate], type number),
		    Invoices = Table.SelectColumns(stg_SalesInvoices, {"invoice_no", "job_no"}),
		    WithJob = Table.ExpandTableColumn(Table.NestedJoin(WithInr, {"invoice_no"}, Invoices, {"invoice_no"}, "Inv", JoinKind.LeftOuter), "Inv", {"job_no"}),
		    Result = Table.TransformColumnTypes(WithJob, {{"job_no", type text}})
		in
		    Result
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_JobBase =
		let
		    // One row per job: master customer, the quote it belongs to (keyed or inferred), and the ratio that scales
		    // the quote to the order: order qty / quote qty (policy rules 1 and 2).
		    Jobs = Table.SelectColumns(
		        stg_JobsMapped,
		        {"job_no", "order_date", "customer_code", "sku_code", "order_qty", "due_date", "completed_on", "rush_order", "repeat_order", "artwork_revised"}
		    ),
		    Link = Table.SelectColumns(stg_JobQuoteLink, {"job_no", "quote_id", "quote_link"}),
		    WithLink = Table.ExpandTableColumn(Table.NestedJoin(Jobs, {"job_no"}, Link, {"job_no"}, "L", JoinKind.LeftOuter), "L", {"quote_id", "quote_link"}),
		    Quotes = Table.SelectColumns(stg_QuotesInr, {"quote_id", "quote_date", "estimator_code", "quantity", "quoted_value_inr"}),
		    WithQuote = Table.ExpandTableColumn(
		        Table.NestedJoin(WithLink, {"quote_id"}, Quotes, {"quote_id"}, "Q", JoinKind.LeftOuter),
		        "Q",
		        {"quote_date", "estimator_code", "quantity", "quoted_value_inr"},
		        {"quote_date", "estimator_code", "quote_qty", "quote_value_inr"}
		    ),
		    Typed = Table.TransformColumnTypes(
		        WithQuote,
		        {
		            {"quote_id", type text}, {"quote_link", type text}, {"quote_date", type date}, {"estimator_code", type text},
		            {"quote_qty", Int64.Type}, {"quote_value_inr", type number}
		        }
		    ),
		    WithRatio = Table.AddColumn(Typed, "qty_ratio", each [order_qty] / [quote_qty], type number),
		    WithQuotedRevenue = Table.AddColumn(WithRatio, "quoted_revenue_inr", each [quote_value_inr] * [qty_ratio], type number)
		in
		    WithQuotedRevenue
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_JobEstimateLines =
		let
		    // Estimated cost per job and cost element: the quote's estimate scaled by order qty / quote qty (policy rule 1).
		    Jobs = Table.SelectColumns(stg_JobBase, {"job_no", "quote_id", "qty_ratio"}),
		    Joined = Table.NestedJoin(Jobs, {"quote_id"}, stg_QuoteEstimateLines, {"quote_id"}, "E", JoinKind.Inner),
		    Expanded = Table.ExpandTableColumn(Joined, "E", {"element_code", "est_cost_inr"}),
		    Scaled = Table.AddColumn(Expanded, "est_inr", each [est_cost_inr] * [qty_ratio], type number),
		    Result = Table.TransformColumnTypes(Table.SelectColumns(Scaled, {"job_no", "element_code", "est_inr"}), {{"element_code", type text}})
		in
		    Result
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_JobActualLines =
		let
		    // Actual direct cost per job and cost element (policy rules 5-11), plus overhead at OverheadRate of each job's direct cost (rule 12).
		    // Unabsorbed machine time has no job and is left out on purpose: it is reported, never charged to jobs.
		    Pick = (source as table, jobColumn as text, costColumn as text, elementCode as text) as table =>
		        Table.AddColumn(
		            Table.RenameColumns(Table.SelectColumns(source, {jobColumn, costColumn}), {{jobColumn, "job_no"}, {costColumn, "actual_inr"}}),
		            "element_code",
		            each elementCode,
		            type text
		        ),
		    Lines = Table.Combine({
		        Pick(stg_BoardIssues, "job_no", "board_cost_inr", "BOARD"),
		        Pick(stg_InkIssuesCosted, "job_no", "ink_cost_inr", "INK"),
		        Pick(stg_PlateLogCosted, "job_no", "plate_cost_inr", "PLATES"),
		        Pick(stg_DieRegister, "first_job_no", "die_cost_inr", "DIES"),
		        Pick(Table.SelectRows(stg_MachineLog, each not [is_unabsorbed]), "job_no", "machine_cost_inr", "MACHINE"),
		        Pick(stg_ReworkLogCosted, "job_no", "rework_cost_inr", "REWORK"),
		        Pick(stg_Dispatches, "job_no", "freight_cost_inr", "FREIGHT")
		    }),
		    Direct = Table.Group(Lines, {"job_no", "element_code"}, {{"actual_inr", each List.Sum([actual_inr]), type number}}),
		    Overhead = Table.Group(Direct, {"job_no"}, {{"actual_inr", each List.Sum([actual_inr]) * OverheadRate, type number}}),
		    OverheadLines = Table.AddColumn(Overhead, "element_code", each "OVERHEAD", type text),
		    Result = Table.Combine({Direct, Table.SelectColumns(OverheadLines, {"job_no", "element_code", "actual_inr"})})
		in
		    Result
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression val_FactJobPL =
		let
		    // Job P&L checks. Every failures value must be 0.
		    // Net revenue is recomputed from invoices and credit notes, independently of the fact (rounded to whole rupees).
		    Fact = #"Fact Job PL",
		    Jobs = stg_JobBase,
		    InvoiceRevenue = List.Sum(stg_InvoicesInr[revenue_inr]) - List.Sum(stg_CreditNotesInr[cn_inr]),
		    FactRevenue = List.Sum(Table.SelectRows(Fact, each [line_code] = "REVENUE" or [line_code] = "CREDIT_NOTES")[actual_inr]),
		    CustomerCodes = List.Buffer(#"Dim Customer"[customer_code]),
		    InvoicedJobs = Table.RowCount(Table.Distinct(Table.SelectColumns(stg_InvoicesInr, {"job_no"}))),
		    Checks = {
		        {"Job P&L", "job with no linked quote estimate", Table.RowCount(Table.SelectRows(Jobs, each [quote_qty] = null))},
		        {"Job P&L", "job with no invoice", Table.RowCount(Jobs) - InvoicedJobs},
		        {"Job P&L", "net revenue differs from invoices less credit notes (Rs)", Number.Round(Number.Abs(FactRevenue - InvoiceRevenue))},
		        {"Job P&L", "customer code not in Dim Customer", Table.RowCount(Table.SelectRows(Fact, each not List.Contains(CustomerCodes, [customer_code])))},
		        {"Job P&L", "actual cost line for a job not in ERP", fnCountOrphans(stg_JobActualLines, "job_no", stg_Jobs, "job_no")},
		        {"Job P&L", "credit note with no invoice", Table.RowCount(Table.SelectRows(stg_CreditNotesInr, each [job_no] = null))},
		        {"Job P&L", "document with no FX rate", Table.RowCount(Table.SelectRows(stg_InvoicesInr, each [fx_rate] = null)) + Table.RowCount(Table.SelectRows(stg_CreditNotesInr, each [fx_rate] = null)) + Table.RowCount(Table.SelectRows(stg_QuotesInr, each [fx_rate] = null))}
		    },
		    Result = #table(type table [area = text, check = text, failures = Int64.Type], Checks)
		in
		    Result
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

