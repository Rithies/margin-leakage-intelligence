	annotation PBI_ResultType = Table

expression stg_DieRegister =
		let
		    // Cutting dies. The full die cost is charged to first_job_no, the job that triggered the die (policy rule 8).
		    Source = Csv.Document(
		        File.Contents(DataFolder & "stores\die_register.csv"),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(
		        Promoted,
		        {
		            {"die_id", type text}, {"sku_code", type text}, {"made_date", type date}, {"first_job_no", type text},
		            {"die_cost_inr", type number}, {"reason", type text}, {"expected_life_imps", Int64.Type}
		        },
		        "en-IN"
		    ),
		    Standardised = Table.TransformColumns(Typed, {{"first_job_no", fnNormaliseJobNo, type nullable text}})
		in
		    Standardised
	lineageTag: c440d0e4-a65e-49ff-82cc-8ffecb679628
