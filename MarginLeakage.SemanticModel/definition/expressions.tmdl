expression fnStandardiseText =
		(inputTable as table, columnName as text, allowedValues as list) as table =>
		let
		    // Replaces each value with its canonical spelling from allowedValues, matched case-insensitively
		    // after trimming. Values with no match are left unchanged so a validation check can flag them.
		    Allowed = List.Buffer(allowedValues),
		    Standardise = (value as nullable text) as nullable text =>
		        if value = null then
		            null
		        else
		            let
		                Position = List.PositionOf(Allowed, Text.Trim(value), Occurrence.First, Comparer.OrdinalIgnoreCase)
		            in
		                if Position = -1 then value else Allowed{Position},
		    Result = Table.TransformColumns(inputTable, {{columnName, Standardise, type text}})
		in
		    Result
	lineageTag: c141e6fd-3e45-457d-b815-765b18cc4df5
	queryGroup: '01 Functions'

