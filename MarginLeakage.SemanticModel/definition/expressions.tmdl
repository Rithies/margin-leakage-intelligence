	annotation PBI_ResultType = Table

expression stg_PlateLogCosted =
		let
		    // Plates costed at the price effective on the made date, by plate format (policy rule 7).
		    WithPrice = fnAddEffectiveValue(stg_PlateLog, "plate_format", "made_date", stg_PlatePriceList, "plate_format", "effective_from", "price_inr_per_plate", "price_inr_per_plate"),
		    WithCost = Table.AddColumn(WithPrice, "plate_cost_inr", each [plates] * [price_inr_per_plate], type nullable number)
		in
		    WithCost
