expression stg_CustomerCodeMap =
		let
		    // Legacy-to-master customer code mapping, maintained in the repo under reference/.
		    Source = Csv.Document(
		        File.Contents(RepoFolder & "reference\customer_code_map.csv"),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(
		        PromotedHeaders,
		        {
		            {"legacy_code", type text},
		            {"master_code", type text},
		            {"gstin", type text},
		            {"reason", type text},
		            {"added_on", type date}
		        },
		        "en-IN"
		    )
		in
		    Typed
	lineageTag: 43464d71-530f-4a85-b2c5-e2717bd9b18d
	queryGroup: '02 Staging'

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fnMapCustomerCode =
		(inputTable as table, codeColumn as text) as table =>
		let
		    // Replaces legacy customer codes with their master code.
		    // The original value is kept as <codeColumn>_source for audit.
		    // Left outer join: unmapped rows pass through unchanged and row count is preserved.
		    Map = Table.SelectColumns(stg_CustomerCodeMap, {"legacy_code", "master_code"}),
		    Joined = Table.NestedJoin(inputTable, {codeColumn}, Map, {"legacy_code"}, "map", JoinKind.LeftOuter),
		    Expanded = Table.ExpandTableColumn(Joined, "map", {"master_code"}),
		    KeptSource = Table.RenameColumns(Expanded, {{codeColumn, codeColumn & "_source"}}),
		    Mapped = Table.AddColumn(KeptSource, codeColumn, each [master_code] ?? Record.Field(_, codeColumn & "_source"), type text),
		    Result = Table.RemoveColumns(Mapped, {"master_code"})
		in
		    Result
	lineageTag: d5ab5122-a5b5-423e-b13d-e3ad221413df
	queryGroup: '01 Functions'

	annotation PBI_ResultType = Function

expression val_CustomerMap_RowsAndTotals =
		let
		    // Checks that fnMapCustomerCode changes codes only. Every check must return 0.
		    //   rows_diff   : row count change after mapping
		    //   value_diff  : taxable_value total change after mapping
		    //   legacy_left : rows still carrying a legacy code
		    Before = stg_SalesInvoices,
		    After = fnMapCustomerCode(Before, "customer_code"),
		    LegacyCodes = List.Buffer(stg_CustomerCodeMap[legacy_code]),
		    Result = #table(
		        type table [check = text, rows_diff = Int64.Type, value_diff = number, legacy_left = Int64.Type],
		        {{
		            "Customer map on sales invoices",
		            Table.RowCount(Before) - Table.RowCount(After),
		            Number.Round(List.Sum(Before[taxable_value]) - List.Sum(After[taxable_value]), 2),
		            Table.RowCount(Table.SelectRows(After, each List.Contains(LegacyCodes, [customer_code])))
		        }}
		    )
		in
		    Result
	lineageTag: 8ecd4c2e-2864-454c-aa88-98f2bb917cc1
	queryGroup: '05 Validation'

	annotation PBI_ResultType = Table

expression val_DimCustomer =
		let
		    // Integrity checks for Dim Customer. Every check must return 0.
		    //   dup_keys         : duplicate customer_code values
		    //   null_keys        : null or blank customer_code values
		    //   rows_diff        : Dim rows vs. staging rows less mapped legacy codes
		    //   unknown_segments : segment values not in reference/segment_list.csv
		    Dim = #"Dim Customer",
		    Codes = Dim[customer_code],
		    AllowedSegments = List.Buffer(stg_SegmentList[segment]),
		    DupKeys = List.Count(Codes) - List.Count(List.Distinct(Codes)),
		    NullKeys = List.Count(List.Select(Codes, each _ = null or Text.Trim(_) = "")),
		    ExpectedRows = Table.RowCount(stg_Customers) - List.Count(stg_CustomerCodeMap[legacy_code]),
		    RowsDiff = Table.RowCount(Dim) - ExpectedRows,
		    UnknownSegments = List.Count(List.Select(Dim[segment], each not List.Contains(AllowedSegments, _))),
		    Result = #table(
		        type table [check = text, dup_keys = Int64.Type, null_keys = Int64.Type, rows_diff = Int64.Type, unknown_segments = Int64.Type],
		        {{"Dim Customer", DupKeys, NullKeys, RowsDiff, UnknownSegments}}
		    )
		in
		    Result
	lineageTag: 76d3519b-3ec5-4518-a3bb-95d23500dfe0
	queryGroup: '05 Validation'

