	annotation PBI_ResultType = Table

expression stg_CartonStyleFactors =
		let
		    // Folder-gluer speed and make-ready factors by carton style.
		    Source = Excel.Workbook(File.Contents(DataFolder & "masters\machines_and_rate_card.xlsx"), false),
		    Sheet = Source{[Item = "Carton Style Factors", Kind = "Sheet"]}[Data],
		    Promoted = fnPromoteHeaderRow(Sheet, "Carton Style"),
		    Renamed = Table.RenameColumns(
		        Promoted,
		        {
		            {"Carton Style", "carton_style"}, {"Style Name", "style_name"},
		            {"Folder-Gluer Speed Factor", "fg_speed_factor"}, {"Folder-Gluer Makeready Factor", "fg_makeready_factor"}
		        }
		    ),
		    Typed = Table.TransformColumnTypes(
		        Renamed,
		        {{"carton_style", type text}, {"style_name", type text}, {"fg_speed_factor", type number}, {"fg_makeready_factor", type number}},
		        "en-IN"
		    )
		in
		    Typed
	lineageTag: 19ed9447-e30a-4a7d-a3d8-1a8ac006882d
