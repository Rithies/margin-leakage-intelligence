	annotation PBI_ResultType = Table

expression stg_MachineLogFiles =
		let
		    // Every MES export file, old and new schema, conformed to one schema. Not yet de-duplicated.
		    // The schema is detected from the columns, not from the file name, so a mislabelled file still routes correctly.
		    Files = Folder.Files(DataFolder & "mes_machine_logs\"),
		    LogFiles = Table.SelectRows(Files, each Text.Lower([Extension]) = ".csv" and Text.StartsWith([Name], "machine_log_")),
		    Conformed = Table.AddColumn(
		        LogFiles,
		        "Log",
		        each
		            let
		                FileName = [Name],
		                Raw = Table.PromoteHeaders(
		                    Csv.Document([Content], [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
		                    [PromoteAllScalars = true]
		                ),
		                Routed = if Table.HasColumns(Raw, "LogID") then fnConformMesV2(Raw) else fnConformMesV1(Raw)
		            in
		                Table.AddColumn(Routed, "source_file", each FileName, type text)
		    ),
		    Combined = Table.Combine(Conformed[Log]),
		    Blanks = Table.ReplaceValue(Combined, "", null, Replacer.ReplaceValue, {"job_no", "operator_code", "stoppage_reason"}),
		    // The new MES renamed the activity labels; both versions map to one standard list.
		    ActivityMap = [
		        MAKEREADY = "Make-ready", RUN = "Run", DOWNTIME = "Stoppage", WASHUP = "Wash-up",
		        #"Make Ready" = "Make-ready", Production = "Run", Stoppage = "Stoppage", #"Wash-up" = "Wash-up"
		    ],
		    Standardised = Table.TransformColumns(
		        Blanks,
		        {
		            {"machine_code", each Text.Remove(Text.Upper(Text.Trim(_)), {"-", " "}), type text},
		            {"job_no", fnNormaliseJobNo, type nullable text},
		            {"activity", each Record.FieldOrDefault(ActivityMap, Text.Trim(_), _), type text}
		        }
		    )
		in
		    Standardised
	lineageTag: 0c1d0c13-7897-4b1f-a23d-394198cd663d
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_MachineLog =
		let
		    // Machine log, one row per segment, with quantity unit and machine-hour cost (costing policy rule 9).
		    // The new MES re-sent some segments in full; a segment is identified by log_id and counted once.
		    Unique = Table.Distinct(stg_MachineLogFiles, {"log_id"}),
		    // Folder-gluers and the window patcher count cartons, not sheets, in qty_in / good_qty / waste_qty.
		    CartonMachines = List.Buffer(Table.SelectRows(stg_Machines, each [speed_unit] = "cartons")[machine_code]),
		    WithUnit = Table.AddColumn(Unique, "qty_unit", each if List.Contains(CartonMachines, [machine_code]) then "cartons" else "sheets", type text),
		    // Segments without a job (maintenance in the old MES) are unabsorbed: reported, never charged to jobs.
		    WithAbsorption = Table.AddColumn(WithUnit, "is_unabsorbed", each [job_no] = null, type logical),
		    WithRate = fnAddEffectiveValue(WithAbsorption, "machine_code", "log_date", stg_MachineRates, "machine_code", "effective_from", "hourly_rate_inr", "hourly_rate_inr"),
		    WithCost = Table.AddColumn(WithRate, "machine_cost_inr", each [duration_hrs] * [hourly_rate_inr], type nullable number)
		in
		    WithCost
	lineageTag: f3c1719f-5d37-43b8-90c5-565cb8a8fa58
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_BoardIssues =
		let
		    // Board issues and returns from stores. Returns are negative quantities.
		    // job_ref uses the stores format (2425/6); qty is in KG or SHEETS depending on uom.
		    Source = Csv.Document(
		        File.Contents(DataFolder & "stores\board_issues.csv"),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(
		        Promoted,
		        {
		            {"issue_no", type text}, {"issue_date", type date}, {"job_ref", type text}, {"board_grade", type text},
		            {"gsm", Int64.Type}, {"sheet_size", type text}, {"qty", type number}, {"uom", type text},
		            {"rate_inr_per_kg", type number}, {"txn_type", type text}
		        },
		        "en-IN"
		    ),
		    WithJob = Table.AddColumn(Typed, "job_no", each fnNormaliseJobNo([job_ref]), type nullable text),
		    // sheet_size is "width x height" in millimetres.
		    WithWidth = Table.AddColumn(WithJob, "sheet_w_mm", each Number.From(Text.BeforeDelimiter([sheet_size], "x")), Int64.Type),
		    WithHeight = Table.AddColumn(WithWidth, "sheet_h_mm", each Number.From(Text.AfterDelimiter([sheet_size], "x")), Int64.Type),
		    // Unit conversion: kg = sheets x width (m) x height (m) x GSM / 1000. Unknown units give null (validation counts them).
		    WithKg = Table.AddColumn(
		        WithHeight,
		        "board_kg",
		        each
		            if [uom] = "KG" then [qty]
		            else if [uom] = "SHEETS" then [qty] * ([sheet_w_mm] / 1000) * ([sheet_h_mm] / 1000) * [gsm] / 1000
		            else null,
		        type nullable number
		    ),
		    WithCost = Table.AddColumn(WithKg, "board_cost_inr", each [board_kg] * [rate_inr_per_kg], type nullable number)
		in
		    WithCost
	lineageTag: efc86c26-e907-4777-9987-414eb5b7e5fd
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_InkIssues =
		let
		    // Ink issued to jobs. Descriptions are free text typed by the ink kitchen.
		    // Identical rows are genuine: each process colour is issued separately and can weigh the same.
		    Source = Csv.Document(
		        File.Contents(DataFolder & "stores\ink_issues.csv"),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(
		        Promoted,
		        {{"job_no", type text}, {"issue_date", type date}, {"ink_description", type text}, {"kg", type number}},
		        "en-IN"
		    ),
		    Standardised = Table.TransformColumns(Typed, {{"job_no", fnNormaliseJobNo, type nullable text}}),
		    WithKey = Table.AddColumn(Standardised, "ink_description_key", each Text.Lower(Text.Trim([ink_description])), type text)
		in
		    WithKey
	lineageTag: 4761f581-4bac-47da-b87a-1b17bac09056
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_InkIssuesCosted =
		let
		    // Ink issues coded to the price-list ink_code and costed at the price effective on the issue date (policy rule 6).
		    Map = Table.SelectColumns(stg_InkDescriptionMap, {"ink_description_key", "ink_code"}),
		    Joined = Table.NestedJoin(stg_InkIssues, {"ink_description_key"}, Map, {"ink_description_key"}, "Map", JoinKind.LeftOuter),
		    Coded = Table.TransformColumnTypes(Table.ExpandTableColumn(Joined, "Map", {"ink_code"}), {{"ink_code", type text}}),
		    WithPrice = fnAddEffectiveValue(Coded, "ink_code", "issue_date", stg_InkPriceList, "ink_code", "effective_from", "price_inr_per_kg", "price_inr_per_kg"),
		    WithCost = Table.AddColumn(WithPrice, "ink_cost_inr", each [kg] * [price_inr_per_kg], type nullable number)
		in
		    WithCost
	lineageTag: 5d9a3b33-14fd-48ce-b855-1908c8f422a7
	queryGroup: '02 Staging'

	annotation PBI_ResultType = Table

expression stg_PlateLog =
		let
		    // CTP plates made for jobs; one row per batch. plate_format is a code (102 or 74), kept as text.
		    Source = Csv.Document(
		        File.Contents(DataFolder & "stores\ctp_plate_log.csv"),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(
		        Promoted,
		        {{"job_no", type text}, {"made_date", type date}, {"plates", Int64.Type}, {"plate_format", type text}, {"reason", type text}},
		        "en-IN"
		    ),
		    Standardised = Table.TransformColumns(Typed, {{"job_no", fnNormaliseJobNo, type nullable text}})
		in
		    Standardised
	lineageTag: 453c5884-7114-46ae-963e-f4878b5743cb
