expression LabourRateInrPerHour = 220 meta [IsParameterQuery=true, Type="Number", IsParameterQueryRequired=true]
	lineageTag: 76249186-94b4-4b61-b283-8340bcfae605
	queryGroup: '00 Parameters'

	annotation PBI_ResultType = Number

expression fnNormaliseJobNo =
		(jobRef as nullable text) as nullable text =>
		let
		    // Converts any job reference to the ERP format JB-YYYY-NNNNN.
		    //   ERP     JB-2425-00006  ->  JB-2425-00006
		    //   MES v2  JB242500006    ->  JB-2425-00006
		    //   Stores  2425/6         ->  JB-2425-00006
		    // Blank input returns null. Input that cannot be parsed is returned unchanged so the orphan checks flag it.
		    Cleaned = if jobRef = null then "" else Text.Upper(Text.Trim(jobRef)),
		    Result =
		        if Cleaned = "" then
		            null
		        else if Text.Contains(Cleaned, "/") then
		            let
		                Parts = Text.Split(Cleaned, "/")
		            in
		                if List.Count(Parts) = 2 then "JB-" & Parts{0} & "-" & Text.PadStart(Parts{1}, 5, "0") else Cleaned
		        else
		            let
		                Digits = Text.Select(Cleaned, {"0".."9"})
		            in
		                if Text.Length(Digits) = 9 then "JB-" & Text.Start(Digits, 4) & "-" & Text.End(Digits, 5) else Cleaned
		in
		    Result
	lineageTag: 5ee00f56-cbec-4bd8-a687-ef117a9b60ad
	queryGroup: '01 Functions'

	annotation PBI_ResultType = Function

expression fnPromoteHeaderRow =
		(sheet as table, firstHeader as text) as table =>
		let
		    // For Excel sheets with title rows above the real header: finds the row whose first cell equals firstHeader,
		    // drops everything above it, promotes it to column names and removes fully blank rows.
		    // Fails loudly if the header row is not found, rather than returning a wrongly shaped table.
		    FirstColumn = Table.Column(sheet, Table.ColumnNames(sheet){0}),
		    HeaderIndex = List.PositionOf(FirstColumn, firstHeader),
		    CheckedIndex =
		        if HeaderIndex = -1 then
		            error Error.Record("Header row not found", "No row starts with '" & firstHeader & "'")
		        else
		            HeaderIndex,
		    Promoted = Table.PromoteHeaders(Table.Skip(sheet, CheckedIndex), [PromoteAllScalars = true]),
		    NonBlank = Table.SelectRows(
		        Promoted,
		        each List.NonNullCount(List.ReplaceValue(Record.FieldValues(_), "", null, Replacer.ReplaceValue)) > 0
		    )
		in
		    NonBlank
	lineageTag: 17301010-158a-4ca1-aa60-c5fa07217bac
	queryGroup: '01 Functions'

	annotation PBI_ResultType = Function

expression fnAddEffectiveValue =
		(inputTable as table, keyColumn as text, dateColumn as text, priceTable as table, priceKeyColumn as text, effectiveFromColumn as text, valueColumn as text, newColumnName as text) as table =>
		let
		    // Effective-dated lookup. For each input row, returns the value from priceTable for the same key whose
		    // effective-from date is the latest one on or before the row's date. Rows with no such price get null,
		    // which the validation queries count.
		    Prices = Table.Buffer(
		        Table.Sort(
		            Table.RenameColumns(
		                Table.SelectColumns(priceTable, {priceKeyColumn, effectiveFromColumn, valueColumn}),
		                {{priceKeyColumn, "PriceKey"}, {effectiveFromColumn, "EffectiveFrom"}, {valueColumn, "PriceValue"}}
		            ),
		            {{"EffectiveFrom", Order.Descending}}
		        )
		    ),
		    Lookup = (key as any, onDate as any) as nullable number =>
		        if key = null or onDate = null then
		            null
		        else
		            let
		                Matches = Table.SelectRows(Prices, each [PriceKey] = key and [EffectiveFrom] <= onDate)
		            in
		                if Table.IsEmpty(Matches) then null else Matches{0}[PriceValue],
		    Result = Table.AddColumn(
		        inputTable,
		        newColumnName,
		        each Lookup(Record.Field(_, keyColumn), Record.Field(_, dateColumn)),
		        type nullable number
		    )
		in
		    Result
	lineageTag: 967afaa1-2e84-4b9d-9a05-fe2dfdb98644
	queryGroup: '01 Functions'

	annotation PBI_ResultType = Function

expression fnCountOrphans =
		(childTable as table, childKeyColumn as text, parentTable as table, parentKeyColumn as text) as number =>
		let
		    // Counts child rows whose non-null key has no match in the parent table. 0 = referential integrity holds.
		    // Uses an anti-join, which scales to large tables (a per-row List.Contains does not).
		    ChildKeys = Table.SelectRows(Table.SelectColumns(childTable, {childKeyColumn}), each Record.Field(_, childKeyColumn) <> null),
		    ParentKeys = Table.Buffer(Table.Distinct(Table.SelectColumns(parentTable, {parentKeyColumn}))),
		    Unmatched = Table.NestedJoin(ChildKeys, {childKeyColumn}, ParentKeys, {parentKeyColumn}, "Parent", JoinKind.LeftAnti)
		in
		    Table.RowCount(Unmatched)
	lineageTag: c8d54cf7-52fd-43d8-b2b3-61aa78871c5c
	queryGroup: '01 Functions'

	annotation PBI_ResultType = Function

expression fnConformMesV1 =
		(logFile as table) as table =>
		let
		    // Old MES export (up to Mar-2025): separate date and HH:mm times, duration in hours.
		    // Output: the common machine-log schema shared with fnConformMesV2.
		    Typed = Table.TransformColumnTypes(
		        logFile,
		        {
		            {"log_id", type text}, {"log_date", type date}, {"shift", type text}, {"machine_code", type text},
		            {"job_no", type text}, {"activity", type text}, {"start_time", type time}, {"end_time", type time},
		            {"duration_hrs", type number}, {"sheets_in", Int64.Type}, {"good_sheets", Int64.Type},
		            {"waste_sheets", Int64.Type}, {"operator_id", type text}, {"downtime_reason", type text}
		        },
		        "en-IN"
		    ),
		    WithStart = Table.AddColumn(Typed, "start_datetime", each [log_date] & [start_time], type datetime),
		    // A segment that runs past midnight has end_time earlier than start_time: its end falls on the next day.
		    WithEnd = Table.AddColumn(
		        WithStart,
		        "end_datetime",
		        each ([log_date] & [end_time]) + (if [end_time] < [start_time] then #duration(1, 0, 0, 0) else #duration(0, 0, 0, 0)),
		        type datetime
		    ),
		    Renamed = Table.RenameColumns(
		        WithEnd,
		        {
		            {"sheets_in", "qty_in"}, {"good_sheets", "good_qty"}, {"waste_sheets", "waste_qty"},
		            {"operator_id", "operator_code"}, {"downtime_reason", "stoppage_reason"}
		        }
		    ),
		    WithVersion = Table.AddColumn(Renamed, "mes_version", each "v1", type text),
		    Result = Table.SelectColumns(
		        WithVersion,
		        {
		            "log_id", "log_date", "start_datetime", "end_datetime", "shift", "machine_code", "job_no", "activity",
		            "duration_hrs", "qty_in", "good_qty", "waste_qty", "operator_code", "stoppage_reason", "mes_version"
		        }
		    )
		in
		    Result
	lineageTag: 6bf5e85c-7603-411a-9a1a-87c3c711a117
	queryGroup: '01 Functions'

	annotation PBI_ResultType = Function

expression fnConformMesV2 =
		(logFile as table) as table =>
		let
		    // New MES export (from Apr-2025): one start timestamp, duration in minutes, different column names.
		    // Output: the common machine-log schema shared with fnConformMesV1.
		    Typed = Table.TransformColumnTypes(
		        logFile,
		        {
		            {"LogID", type text}, {"LogStart", type datetime}, {"Shift", type text}, {"Machine", type text},
		            {"JobNumber", type text}, {"Activity", type text}, {"DurationMinutes", type number}, {"SheetsIn", Int64.Type},
		            {"GoodSheets", Int64.Type}, {"WasteSheets", Int64.Type}, {"OperatorCode", type text}, {"StoppageReason", type text}
		        },
		        "en-IN"
		    ),
		    Renamed = Table.RenameColumns(
		        Typed,
		        {
		            {"LogID", "log_id"}, {"LogStart", "start_datetime"}, {"Shift", "shift"}, {"Machine", "machine_code"},
		            {"JobNumber", "job_no"}, {"Activity", "activity"}, {"SheetsIn", "qty_in"}, {"GoodSheets", "good_qty"},
		            {"WasteSheets", "waste_qty"}, {"OperatorCode", "operator_code"}, {"StoppageReason", "stoppage_reason"}
		        }
		    ),
		    // Unit conversion: minutes to hours. The log date is the date on which the segment starts.
		    WithHours = Table.AddColumn(Renamed, "duration_hrs", each [DurationMinutes] / 60, type number),
		    WithDate = Table.AddColumn(WithHours, "log_date", each DateTime.Date([start_datetime]), type date),
		    WithEnd = Table.AddColumn(WithDate, "end_datetime", each [start_datetime] + Duration.From([DurationMinutes] / 1440), type datetime),
		    WithVersion = Table.AddColumn(WithEnd, "mes_version", each "v2", type text),
		    Result = Table.SelectColumns(
		        WithVersion,
		        {
		            "log_id", "log_date", "start_datetime", "end_datetime", "shift", "machine_code", "job_no", "activity",
		            "duration_hrs", "qty_in", "good_qty", "waste_qty", "operator_code", "stoppage_reason", "mes_version"
		        }
		    )
		in
		    Result
	lineageTag: 5e51edd2-06b4-4155-9a26-b3a399a0b7c8
	queryGroup: '01 Functions'

	annotation PBI_ResultType = Function

expression stg_InkDescriptionMap =
		let
		    // Free-text ink descriptions typed by the ink kitchen, mapped to price-list ink codes. Maintained in the repo under reference/.
		    Source = Csv.Document(
		        File.Contents(RepoFolder & "reference\ink_description_map.csv"),
		        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
		    ),
		    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
		    Typed = Table.TransformColumnTypes(PromotedHeaders, {{"ink_description", type text}, {"ink_code", type text}}, "en-IN"),
		    // Matching is case- and space-insensitive, so the file needs one row per spelling, not per capitalisation.
		    WithKey = Table.AddColumn(Typed, "ink_description_key", each Text.Lower(Text.Trim([ink_description])), type text)
		in
		    WithKey
