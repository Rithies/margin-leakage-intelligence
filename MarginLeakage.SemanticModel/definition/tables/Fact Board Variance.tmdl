/// Grain: one row per job. Board estimate (quote kg and price, scaled to the order), actual issues (kg and cost)
/// and the market price of the SKU's board grade in the order month. Splits the board variance into usage, planning price and purchase price.
table 'Fact Board Variance'

	column job_no
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: job_no

	column customer_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: customer_code

	column estimator_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: estimator_code

	column sku_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: sku_code

	column invoice_date
		dataType: dateTime
		isHidden
		formatString: dd-mmm-yyyy
		summarizeBy: none
		sourceColumn: invoice_date

		annotation UnderlyingDateTimeDataType = Date

	column est_kg
		dataType: double
		isHidden
		formatString: #,0
		summarizeBy: sum
		sourceColumn: est_kg

	column est_price_inr_per_kg
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: est_price_inr_per_kg

	column market_price_inr_per_kg
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: market_price_inr_per_kg

	column actual_kg
		dataType: double
		isHidden
		formatString: #,0
		summarizeBy: sum
		sourceColumn: actual_kg

	column actual_cost_inr
		dataType: double
		isHidden
		formatString: #,0
		summarizeBy: sum
		sourceColumn: actual_cost_inr

	partition 'Fact Board Variance' = m
		mode: import
		queryGroup: '04 Facts'
		source =
				let
				    Jobs = Table.SelectColumns(stg_JobBase, {"job_no", "quote_id", "qty_ratio", "customer_code", "estimator_code", "sku_code", "order_date"}),
				    QuoteBoard = Table.SelectColumns(stg_QuoteEstimates, {"quote_id", "est_board_kg", "est_board_price_per_kg"}),
				    WithEstimate = Table.ExpandTableColumn(
				        Table.NestedJoin(Jobs, {"quote_id"}, QuoteBoard, {"quote_id"}, "Q", JoinKind.LeftOuter), "Q", {"est_board_kg", "est_board_price_per_kg"}
				    ),
				    EstKg = Table.AddColumn(WithEstimate, "est_kg", each [est_board_kg] * [qty_ratio], type number),
				    // Issues and returns summed to job grain before joining (returns are negative), so the join cannot fan out.
				    Issues = Table.Group(
				        stg_BoardIssues,
				        {"job_no"},
				        {{"actual_kg", each List.Sum([board_kg]), type number}, {"actual_cost_inr", each List.Sum([board_cost_inr]), type number}}
				    ),
				    WithActual = Table.ExpandTableColumn(Table.NestedJoin(EstKg, {"job_no"}, Issues, {"job_no"}, "I", JoinKind.LeftOuter), "I", {"actual_kg", "actual_cost_inr"}),
				    Grades = Table.SelectColumns(stg_Skus, {"sku_code", "board_grade"}),
				    WithGrade = Table.ExpandTableColumn(Table.NestedJoin(WithActual, {"sku_code"}, Grades, {"sku_code"}, "S", JoinKind.LeftOuter), "S", {"board_grade"}),
				    Typed = Table.TransformColumnTypes(WithGrade, {{"board_grade", type text}, {"actual_kg", type number}, {"actual_cost_inr", type number}}),
				    // Market price = the grade's price-list price in the order month: what the estimator should have used.
				    WithMarket = fnAddEffectiveValue(Typed, "board_grade", "order_date", stg_BoardPriceHistory, "grade_code", "month_start", "price_inr_per_kg", "market_price_inr_per_kg"),
				    Invoices = Table.SelectColumns(stg_InvoicesInr, {"job_no", "invoice_date"}),
				    WithDate = Table.ExpandTableColumn(Table.NestedJoin(WithMarket, {"job_no"}, Invoices, {"job_no"}, "Inv", JoinKind.LeftOuter), "Inv", {"invoice_date"}),
				    Renamed = Table.RenameColumns(WithDate, {{"est_board_price_per_kg", "est_price_inr_per_kg"}}),
				    Result = Table.TransformColumnTypes(
				        Table.SelectColumns(
				            Renamed,
				            {"job_no", "customer_code", "estimator_code", "sku_code", "invoice_date", "est_kg", "est_price_inr_per_kg", "market_price_inr_per_kg", "actual_kg", "actual_cost_inr"}
				        ),
				        {{"invoice_date", type date}, {"est_price_inr_per_kg", type number}}
				    )
				in
				    Result

	annotation PBI_ResultType = Table

