/// Grain: one rework event, costed per policy rule 10 (machine hours, labour hours and extra board).
table 'Fact Rework'

	column rework_id
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: rework_id

	column job_no
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: job_no

	column customer_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: customer_code

	column reason_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: reason_code

	column machine_code
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: machine_code

	column reported_on
		dataType: dateTime
		isHidden
		formatString: dd-mmm-yyyy
		summarizeBy: none
		sourceColumn: reported_on

		annotation UnderlyingDateTimeDataType = Date

	column rework_hours
		dataType: double
		isHidden
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: rework_hours

	column labour_hours
		dataType: double
		isHidden
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: labour_hours

	column extra_board_kg
		dataType: double
		isHidden
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: extra_board_kg

	column rework_cost_inr
		dataType: double
		isHidden
		formatString: #,0
		summarizeBy: sum
		sourceColumn: rework_cost_inr

	partition 'Fact Rework' = m
		mode: import
		queryGroup: '04 Facts'
		source =
				let
				    Jobs = Table.SelectColumns(stg_JobsMapped, {"job_no", "customer_code"}),
				    WithCustomer = Table.ExpandTableColumn(Table.NestedJoin(stg_ReworkLogCosted, {"job_no"}, Jobs, {"job_no"}, "J", JoinKind.LeftOuter), "J", {"customer_code"}),
				    Result = Table.TransformColumnTypes(
				        Table.SelectColumns(
				            WithCustomer,
				            {"rework_id", "job_no", "customer_code", "reason_code", "machine_code", "reported_on", "rework_hours", "labour_hours", "extra_board_kg", "rework_cost_inr"}
				        ),
				        {{"customer_code", type text}}
				    )
				in
				    Result

	annotation PBI_ResultType = Table

